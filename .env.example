# ===== Telegram =====
# Token del bot de Telegram (obtén en @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABC-DEF...

# ===== Cuenta legacy (SOLO migración inicial) =====
# Chat ID del administrador. El bot migra automáticamente esta cuenta
# a la base de datos multiusuario la primera vez que arranca
# (solo si la base de datos está vacía).
TELEGRAM_CHAT_ID=706081601

# URL de la instancia Moodle de esta cuenta legacy
MOODLE_URL=https://akumajafiug.uniguajira.edu.co
MOODLE_USERNAME=tu_usuario
MOODLE_PASSWORD=tu_contraseña

# ===== Seguridad (opcional pero recomendado en producción) =====
# Clave maestra para cifrar las contraseñas de los usuarios.
# Si no se define, se genera automáticamente un archivo local akumaja.key.
# Genera una con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# AKUMAJA_ENCRYPTION_KEY=