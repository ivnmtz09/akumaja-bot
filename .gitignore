.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Base de datos local
*.db
*.sqlite3

# Logs
*.log

# Archivos temporales
*.tmp
*.bak

